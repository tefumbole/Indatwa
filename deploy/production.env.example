# Copy to ~/Indatwa/backend/.env on Hostinger
# PHP 7.4 compatible (Laravel 8)

APP_NAME="Indatwa Protocol & Services"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://indatwagency.com
FRONTEND_URL=https://indatwagency.com

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=YOUR_HPANEL_DB_NAME
DB_USERNAME=YOUR_HPANEL_DB_USER
DB_PASSWORD="YOUR_DB_PASSWORD"

QUEUE_CONNECTION=database
SESSION_DRIVER=file
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=noreply@indatwagency.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@indatwagency.com
MAIL_FROM_NAME="${APP_NAME}"

WASENDER_API_KEY=
WASENDER_BASE_URL=https://wasenderapi.com/api
COMPANY_NAME="Indatwa Protocol & Services Agency"
ADMIN_PHONE=+250780759253
ADMIN_EMAIL=admin@indatwagency.com

CORS_ALLOWED_ORIGINS=https://indatwagency.com,https://www.indatwagency.com
SANCTUM_STATEFUL_DOMAINS=indatwagency.com,www.indatwagency.com
